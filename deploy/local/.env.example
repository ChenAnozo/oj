# Start-Environment.ps1 generates deploy/local/.env with independent random secrets.
# Do not use these placeholders as credentials.
MYSQL_ROOT_PASSWORD=GENERATE_ME
MYSQL_PASSWORD=GENERATE_ME
REDIS_PASSWORD=GENERATE_ME
RABBITMQ_PASSWORD=GENERATE_ME
NACOS_AUTH_TOKEN=GENERATE_BASE64_SECRET
NACOS_AUTH_IDENTITY_VALUE=GENERATE_ME
NACOS_ADMIN_PASSWORD=GENERATE_ME
MYSQL_PORT=13306
REDIS_PORT=16379
RABBITMQ_AMQP_PORT=15673
RABBITMQ_HTTP_PORT=15674
NACOS_HTTP_PORT=18848
NACOS_GRPC_PORT=19848
# Added automatically by Start-Services.ps1, once the Docker sandbox is authorized.
SANDBOX_AUTH_SECRET=GENERATE_ME
SANDBOX_HOST_WORKSPACE_ROOT=/var/lib/docker/volumes/yuoj-local-sandbox-work/_data
GATEWAY_PORT=18101
SANDBOX_PORT=18090
SANDBOX_INSTANCES=1
SANDBOX2_HOST_WORKSPACE_ROOT=/var/lib/docker/volumes/yuoj-local-sandbox-work-2/_data
SANDBOX3_HOST_WORKSPACE_ROOT=/var/lib/docker/volumes/yuoj-local-sandbox-work-3/_data
SANDBOX_CLIENT_TYPE=discovery
SANDBOX_MAX_CONCURRENT=6
WEBSITE_PORT=18081


JUDGE_CONSUMERS=12
# Maximum UTF-8 bytes in serialized question judgeCase JSON.
JUDGE_CASE_MAX_BYTES=1048576

# Temporary question-service pool diagnostics (one compact log per second).
JUDGE_DIAGNOSTICS_ENABLED=false
